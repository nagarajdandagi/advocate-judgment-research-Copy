# Advocate Legal Judgment Research System — India
# Environment Configuration Template

# Database Connection (Supabase PostgreSQL)
# Mode 1: Supabase Pooler (Recommended for Serverless / Vercel deployment)
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
#
# Mode 2: Direct Connection
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Application Server Host & Port (Accessible over local network)
PORT=3000
HOSTNAME="0.0.0.0"

# JWT Secret for Session & Authentication
JWT_SECRET="advocate_legal_research_secret_key_change_in_production"

# Configurable LLM API for Judgment Summaries & Case Brief Extraction
# Supported providers: "mock" (offline fallback), "openai", "gemini", "anthropic"
LLM_API_PROVIDER="mock"
LLM_API_KEY=""
LLM_MODEL="gemini-1.5-pro"

# Application Branding
NEXT_PUBLIC_APP_NAME="ADVOCATE JUDGMENT RESEARCH"
NEXT_PUBLIC_APP_SUBTITLE="Supreme Court of India | High Court of Karnataka"
